{
  "manifest_version": 3,
  "name": "BugPilot",
  "version": "1.0.0",
  "description": "Debug errors instantly from any webpage using AI",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
  "https://bugpilotai.onrender.com/*",
  "https://*/*"
 ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "BugPilot AI"
  },
"icons": {
  "128": "icons/icon.jpg"
}
}